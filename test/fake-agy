#!/usr/bin/env bash
# Fake agy for tests. Behaviour depends on the (fake) token content in $AGY_HOME:
#   - token listed in FAKE_QUOTA_TOKENS (space-separated) -> print a 429 error, then hang like agy retrying
#   - FAKE_AUTH=1 -> print a login error, exit 1
#   - FAKE_STALE_ERROR=1 -> init + a result event with status ERROR that merely echoes an old quota error
#   - otherwise -> init + SUCCESS result
# Every call appends "token|argv" to $FAKE_ARGS_LOG.
set -u
tok="$(cat "$AGY_HOME/antigravity-oauth-token")"
echo "$tok|$*" >>"${FAKE_ARGS_LOG:?}"

# Fake /quota, same format as the real agy. Percentages derive from the token's last character: 5h = 50+10n, week = 40+10n.
#   FAKE_DEAD_TOKENS: tokens treated as logged out (status ERROR)
#   FAKE_ZERO_TOKENS: tokens that are out of 5h quota (0%)
#   FAKE_P5:          force the 5h percentage for every token
#   FAKE_LOW_TOKENS:  tokens with 5% of the 5h quota left
#   FAKE_TTY=1:       try to change the terminal mode (stty) like the real agy
#   FAKE_REFRESH=1:   rewrite the token file (simulates agy refreshing the access token itself)
prev=""
for a in "$@"; do
  if [ "$prev" = "-p" ] && [ "$a" = "/quota" ]; then
    for d in ${FAKE_DEAD_TOKENS:-}; do
      [ "$d" = "$tok" ] && { echo '{"event":"result","result":{"status":"ERROR","error":"not logged in"}}'; exit 1; }
    done
    # FAKE_TTY=1: like the real agy, try to change the controlling terminal's mode (only has an effect if agyr does NOT detach agy from the terminal)
    if [ "${FAKE_TTY:-0}" = 1 ]; then stty -icanon -echo </dev/tty >/dev/null 2>&1 || true; fi
    # digit taken from "rt-accN" in a JSON token, otherwise from the token's last character
    if [[ "$tok" =~ rt-acc([0-9]) ]]; then n="${BASH_REMATCH[1]}"; else n="${tok: -1}"; fi
    [[ "$n" =~ ^[0-9]$ ]] || n=0
    p5=$((50 + n * 10)); pw=$((40 + n * 10))
    for z in ${FAKE_ZERO_TOKENS:-}; do [ "$z" = "$tok" ] && p5=0; done
    [[ "${FAKE_P5:-}" =~ ^[0-9]+$ ]] && p5="$FAKE_P5"
    for z in ${FAKE_LOW_TOKENS:-}; do [ "$z" = "$tok" ] && p5=5; done
    # FAKE_REFRESH=1: agy "refreshes the token itself" by rewriting the token file in its own HOME
    if [ "${FAKE_REFRESH:-0}" = 1 ]; then echo "$tok-refreshed" >"$AGY_HOME/antigravity-oauth-token"; fi
    now="${AGY_NOW:-$(date +%s)}"
    r5="$(date -u -d "@$((now + 3600))" +%Y-%m-%dT%H:%M:%SZ)"
    rw="$(date -u -d "@$((now + 259200))" +%Y-%m-%dT%H:%M:%SZ)"
    resp="$(printf 'Gemini Models\tWeekly Limit Remaining\t%s%%\t%s\nGemini Models\tFive Hour Limit Remaining\t%s%%\t%s\nClaude and GPT models\tWeekly Limit Remaining\t100%%\t%s\nClaude and GPT models\tFive Hour Limit Remaining\t100%%\t%s\n' "$pw" "$rw" "$p5" "$r5" "$rw" "$r5")"
    jq -nc --arg r "$resp" '{event:"result",result:{status:"SUCCESS",response:$r,num_turns:0}}'
    exit 0
  fi
  prev="$a"
done

cid="conv-fake-1"
prev=""
for a in "$@"; do
  [ "$prev" = "--conversation" ] && cid="$a"
  prev="$a"
done

if [ "${FAKE_AUTH:-0}" = 1 ]; then
  echo "Error: authentication required. Run 'agy' to log in, then retry." >&2
  exit 1
fi

echo "{\"event\":\"init\",\"conversation_id\":\"$cid\",\"init\":{\"model\":\"fake\"}}"
for q in ${FAKE_QUOTA_TOKENS:-}; do
  if [ "$q" = "$tok" ]; then
    echo "error: Individual quota reached. Please upgrade your subscription to increase your limits. Resets in ${FAKE_RESET:-4h13m19s}. (response may be truncated)"
    echo 'AGY_ERROR: {"short_error":"RESOURCE_EXHAUSTED (code 429): Individual quota reached.","error_code":429}'
    sleep 30 # the real agy retries ~8 times; agy-run must kill it before that
    exit 1
  fi
done
if [ "${FAKE_STALE_ERROR:-0}" = 1 ]; then
  # a resumed conversation: the run worked, but the final result event echoes the OLD quota error (no plain-text error lines)
  echo '{"event":"result","result":{"status":"ERROR","response":"all done","error":"Individual quota reached. Please upgrade your subscription to increase your limits. Resets in 2h19m16s.","num_turns":3}}'
  exit 0
fi
echo '{"event":"result","result":{"status":"SUCCESS","response":"ok","num_turns":1}}'
