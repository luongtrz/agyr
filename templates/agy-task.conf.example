# agy-task.conf — configuration for agy-task runs
# Copy to .agy-sessions/agy-task.conf in your repository root, or point to it via AGY_TASK_CONF.

# Commands to run in order inside the newly created worktree before agy starts.
# Runs via `bash -c` from the worktree root. Execution stops on the first failure.
SETUP_CMDS=(
  'pnpm install --frozen-lockfile --prefer-offline'
  'pnpm api:gen'
)

# Files to copy from the main checkout to the worktree AFTER SETUP_CMDS finishes.
# Parent directories are created automatically. Missing source files trigger a warning, not an error.
COPY_FILES=(
  apps/web/src/routeTree.gen.ts
)

# Named verification presets selected via --verify <name>.
# Note: 'go test ./...' is deliberately not part of the backend preset because that
# repository's Go tests hit a shared dev database. For backend tasks, pass a targeted
# ad-hoc check instead: --verify-cmd 'cd backend && go test ./internal/foo/...'
declare -A VERIFY=(
  [web]='pnpm turbo run type-check lint test --filter=web'
  [web-user]='pnpm turbo run type-check lint test --filter=web-user'
  [web-admin]='pnpm turbo run type-check lint test --filter=web-admin'
  [backend]='cd backend && go vet ./... && go build ./...'
)

# Default verify presets used when neither --verify nor --verify-cmd is specified.
DEFAULT_VERIFY=()
