#!/usr/bin/env bash
# agy-acct — lưu / đổi / xoay vòng nhiều account cho agy (Antigravity CLI).
#
# Chỉ copy file token qua lại; không bao giờ in nội dung token ra màn hình.
# Biến môi trường (dùng cho test):
#   AGY_HOME  thư mục dữ liệu của agy (mặc định ~/.gemini/antigravity-cli)
#   AGY_BIN   binary agy dùng cho lệnh quota (mặc định agy)
#   AGY_TZ    múi giờ để hiển thị và đọc giờ trong log agy (mặc định UTC-7, tức UTC+7 theo quy ước POSIX)
#   AGY_NOW   epoch giả lập cho "bây giờ" (mặc định date +%s)
set -euo pipefail
umask 077

# Mọi giờ hiển thị (và giờ trong log agy) tính theo UTC+7. Lưu ý quy ước POSIX: 'UTC-7' nghĩa là UTC+7.
export TZ="${AGY_TZ:-UTC-7}"

AGY_HOME="${AGY_HOME:-$HOME/.gemini/antigravity-cli}"
AGY_BIN="${AGY_BIN:-agy}"
TOKEN="$AGY_HOME/antigravity-oauth-token"
ACCTS="$AGY_HOME/accounts"
STATE="$ACCTS/state.json"
DEFAULT_COOLDOWN=18000 # 5h, dùng khi không parse được "Resets in"

die() { echo "agy-acct: $*" >&2; exit "${2:-1}"; }
now() { echo "${AGY_NOW:-$(date +%s)}"; }

need_jq() { command -v jq >/dev/null || die "cần cài jq"; }

valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "tên account chỉ gồm chữ, số, '-', '_': '$1'"; }

init_state() {
  mkdir -p "$ACCTS"
  chmod 700 "$ACCTS"
  [ -f "$STATE" ] || echo '{"active":"","cooldown":{}}' >"$STATE"
}

# ghi state nguyên tử: $1 = biểu thức jq, các tham số còn lại truyền cho jq
state_update() {
  local expr="$1"; shift
  local tmp
  tmp="$(mktemp "$ACCTS/.state.XXXXXX")"
  if jq "$@" "$expr" "$STATE" >"$tmp"; then mv "$tmp" "$STATE"; else rm -f "$tmp"; die "ghi state lỗi"; fi
}

active_name() { jq -r '.active // ""' "$STATE"; }

# "4h13m27s" / "43m29s" / "1d2h" / "90" (giây) -> số giây. Chấp nhận cả câu chứa "Resets in X".
parse_duration() {
  local s="$1"
  if [[ "$s" =~ Resets\ in\ ([0-9dhms]+) ]]; then s="${BASH_REMATCH[1]}"; fi
  if [[ "$s" =~ ^[0-9]+$ ]]; then echo "$s"; return 0; fi
  [[ "$s" =~ ^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$ && -n "$s" ]] || return 1
  local total=0 d=${BASH_REMATCH[1]:-} h=${BASH_REMATCH[2]:-} m=${BASH_REMATCH[3]:-} sec=${BASH_REMATCH[4]:-}
  [ -n "$d" ] && total=$((total + ${d%d} * 86400))
  [ -n "$h" ] && total=$((total + ${h%h} * 3600))
  [ -n "$m" ] && total=$((total + ${m%m} * 60))
  [ -n "$sec" ] && total=$((total + ${sec%s}))
  echo "$total"
}

fmt_dur() { # giây -> "4h13m"
  local s=$1
  if [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

slots() { # liệt kê tên các slot, sắp xếp
  local f
  for f in "$ACCTS"/*.token; do
    [ -e "$f" ] || continue
    basename "$f" .token
  done | sort
}

cooldown_until() { jq -r --arg n "$1" '.cooldown[$n] // 0' "$STATE"; }

cmd_save() {
  [ $# -eq 1 ] || die "dùng: agy-acct save <name>"
  valid_name "$1"; need_jq
  [ -f "$TOKEN" ] || die "chưa có token ($TOKEN). Hãy login bằng 'agy' trước"
  init_state
  cp "$TOKEN" "$ACCTS/$1.token"; chmod 600 "$ACCTS/$1.token"
  state_update '.active=$n | del(.cooldown[$n])' --arg n "$1"
  echo "đã lưu account '$1' (đang active)"
}

cmd_use() {
  [ $# -eq 1 ] || die "dùng: agy-acct use <name>"
  valid_name "$1"; need_jq; init_state
  [ -f "$ACCTS/$1.token" ] || die "không có slot '$1' (xem: agy-acct list)"
  local cur; cur="$(active_name)"
  if [ -f "$TOKEN" ]; then
    cp "$TOKEN" "$ACCTS/.last-token.bak"; chmod 600 "$ACCTS/.last-token.bak"
    # giữ access token đã được agy refresh cho account đang active
    if [ -n "$cur" ] && [ "$cur" != "$1" ] && [ -f "$ACCTS/$cur.token" ]; then
      cp "$TOKEN" "$ACCTS/$cur.token"; chmod 600 "$ACCTS/$cur.token"
    fi
  fi
  cp "$ACCTS/$1.token" "$TOKEN"; chmod 600 "$TOKEN"
  state_update '.active=$n' --arg n "$1"
  echo "đã chuyển sang account '$1'"
}

cmd_list() {
  need_jq; init_state
  local cur n until t rem q
  cur="$(active_name)"; t="$(now)"
  local any=0
  while read -r n; do
    any=1
    until="$(cooldown_until "$n")"
    if [ "$until" -gt "$t" ]; then
      rem=$((until - t))
      printf '%s %-16s cooldown, còn %s (reset %s)\n' "$([ "$n" = "$cur" ] && echo '*' || echo ' ')" "$n" "$(fmt_dur "$rem")" "$(date -d "@$until" '+%F %H:%M')"
    else
      printf '%s %-16s sẵn sàng\n' "$([ "$n" = "$cur" ] && echo '*' || echo ' ')" "$n"
    fi
    q="$(quota_summary "$n")"
    if [ -n "$q" ]; then printf '    %s\n' "$q"; fi
  done < <(slots)
  [ "$any" -eq 1 ] || echo "(chưa có account nào; login bằng 'agy' rồi chạy 'agy-acct save <name>')"
}

cmd_cooldown() {
  [ $# -ge 2 ] || die "dùng: agy-acct cooldown <name> <duration|'... Resets in 4h13m27s'>"
  local name="$1"; shift
  valid_name "$name"; need_jq; init_state
  [ -f "$ACCTS/$name.token" ] || die "không có slot '$name'"
  local secs
  if ! secs="$(parse_duration "$*")"; then
    echo "agy-acct: không parse được thời gian '$*', dùng mặc định 5h" >&2
    secs=$DEFAULT_COOLDOWN
  fi
  local until=$(($(now) + secs))
  state_update '.cooldown[$n]=$u' --arg n "$name" --argjson u "$until"
  echo "account '$name' cooldown $(fmt_dur "$secs") (reset $(date -d "@$until" '+%F %H:%M'))"
}

cmd_clear() {
  [ $# -eq 1 ] || die "dùng: agy-acct clear <name>"
  valid_name "$1"; need_jq; init_state
  state_update 'del(.cooldown[$n])' --arg n "$1"
  echo "đã xóa cooldown của '$1'"
}

# In tên account sẵn sàng kế tiếp (vòng tròn, bắt đầu sau account active).
# Hết sạch thì exit 3 và báo thời điểm reset sớm nhất.
cmd_next() {
  need_jq; init_state
  local cur t; cur="$(active_name)"; t="$(now)"
  local -a names=()
  mapfile -t names < <(slots)
  [ "${#names[@]}" -gt 0 ] || die "chưa có account nào" 2
  local start=0 i
  for i in "${!names[@]}"; do [ "${names[$i]}" = "$cur" ] && start=$((i + 1)); done
  local k idx n until earliest=0 earliest_n=""
  for ((k = 0; k < ${#names[@]}; k++)); do
    idx=$(((start + k) % ${#names[@]}))
    n="${names[$idx]}"
    until="$(cooldown_until "$n")"
    if [ "$until" -le "$t" ]; then echo "$n"; return 0; fi
    if [ "$earliest" -eq 0 ] || [ "$until" -lt "$earliest" ]; then earliest=$until; earliest_n=$n; fi
  done
  echo "agy-acct: tất cả ${#names[@]} account đều đang cooldown; sớm nhất: '$earliest_n' reset $(date -d "@$earliest" '+%F %H:%M') (còn $(fmt_dur $((earliest - t))))" >&2
  return 3
}

# Tìm lần chạm quota gần nhất trong log của agy; in số giây còn lại tới lúc reset (tính từ "bây giờ").
# Dòng log dạng: E1001 12:49:02.672827 ... Individual quota reached ... Resets in 3h13m51s.
# Bỏ qua dòng cũ hơn 1 giờ (rất có thể là của account khác / lần trước).
detect_reset_secs() {
  local logdir="$AGY_HOME/log" f line best_ts=0 best_reset=0 ts reset d t y t0
  [ -d "$logdir" ] || return 1
  t0="$(now)"
  y="$(date -d "@$t0" +%Y)"
  while read -r f; do
    line="$(grep -E 'Individual quota reached.*Resets in [0-9dhms]+' "$f" | tail -n 1)" || true
    [ -n "$line" ] || continue
    if [[ "$line" =~ ^[A-Z]([0-9]{2})([0-9]{2})\ ([0-9:]{8}) ]]; then
      d="$y-${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"; t="${BASH_REMATCH[3]}"
      ts="$(date -d "$d $t" +%s 2>/dev/null)" || continue
      [ "$ts" -gt $((t0 + 86400)) ] && ts="$(date -d "$((y - 1))-${BASH_REMATCH[1]}-${BASH_REMATCH[2]} $t" +%s)"
    else
      continue
    fi
    reset="$(parse_duration "$(grep -oE 'Resets in [0-9dhms]+' <<<"$line" | tail -n 1)")" || continue
    if [ "$ts" -gt "$best_ts" ]; then best_ts=$ts; best_reset=$reset; fi
  done < <(find "$logdir" -maxdepth 1 -name 'cli-*.log' -mmin -61 2>/dev/null)
  [ "$best_ts" -gt 0 ] || return 1
  [ $((t0 - best_ts)) -le 3600 ] || return 1
  local remain=$((best_ts + best_reset - t0))
  [ "$remain" -gt 0 ] || return 1
  echo "$remain"
}

# Hết quota khi dùng agy tay: đánh dấu account đang active là cooldown rồi chuyển sang account kế tiếp.
cmd_rotate() {
  need_jq; init_state
  local cur secs src
  cur="$(active_name)"
  [ -n "$cur" ] || die "chưa có account active (xem: agy-acct list)"
  if [ $# -ge 1 ]; then
    secs="$(parse_duration "$*")" || die "không hiểu thời gian '$*' (ví dụ: 4h13m)"
    src="theo bạn nhập"
  elif secs="$(detect_reset_secs)"; then
    src="đọc từ log agy"
  else
    secs=$DEFAULT_COOLDOWN
    src="không thấy lỗi quota mới trong log, dùng mặc định 5h"
  fi
  local until=$(($(now) + secs))
  state_update '.cooldown[$n]=$u' --arg n "$cur" --argjson u "$until"
  echo "account '$cur' cooldown $(fmt_dur "$secs") ($src; reset $(date -d "@$until" '+%F %H:%M'))"
  local nxt
  if ! nxt="$(cmd_next)"; then return 3; fi
  cmd_use "$nxt"
  echo "mở lại agy (đang là process mới) bằng: agy -c"
}

# Chạy `agy -p /quota` (không gọi model, 0 token) trên token đang active; in các dòng
# "<nhóm>\t<chỉ số>\t<phần trăm>\t<giờ reset UTC>". Lỗi thì return 1.
quota_fetch() {
  local tmp out
  tmp="$(mktemp -d)"
  out="$("$AGY_BIN" -p /quota --add-dir "$tmp" --model gemini-3.8-flash-high --output-format stream-json 2>/dev/null |
    grep '^{' | jq -r 'select(.event=="result") | select(.result.status=="SUCCESS") | .result.response' 2>/dev/null)" || true
  rm -rf "$tmp"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# In quota của account có token đang active, lưu snapshot vào state; về 0% thì đặt cooldown tới giờ reset.
quota_show() {
  local name="$1" raw grp metric pct reset epoch g5="" g5r=0 gw="" gwr=0
  if ! raw="$(quota_fetch)"; then
    echo "  (không lấy được quota: chưa đăng nhập hoặc agy lỗi)"
    return 1
  fi
  while IFS=$'\t' read -r grp metric pct reset; do
    [ -n "$reset" ] || continue
    epoch="$(date -d "$reset" +%s 2>/dev/null)" || continue
    case "$grp|$metric" in
      "Gemini Models|Five Hour"*) g5="${pct%\%}"; g5r="$epoch" ;;
      "Gemini Models|Weekly"*) gw="${pct%\%}"; gwr="$epoch" ;;
    esac
    printf '  %-22s %-27s %5s   reset %s\n' "$grp" "$metric" "$pct" "$(date -d "@$epoch" '+%m-%d %H:%M')"
  done <<<"$raw"
  if [[ "$g5" =~ ^[0-9]+$ && "$gw" =~ ^[0-9]+$ ]]; then
    state_update '.quota[$n]={at:$t,g5:$a,g5r:$ar,gw:$b,gwr:$br}' --arg n "$name" --argjson t "$(now)" \
      --argjson a "$g5" --argjson ar "$g5r" --argjson b "$gw" --argjson br "$gwr"
    local until=0
    if [ "$g5" -eq 0 ]; then until=$g5r; fi
    if [ "$gw" -eq 0 ] && [ "$gwr" -gt "$until" ]; then until=$gwr; fi
    if [ "$until" -gt "$(now)" ]; then
      state_update '.cooldown[$n]=$u' --arg n "$name" --argjson u "$until"
      echo "  → hết quota Gemini: đặt cooldown tới $(date -d "@$until" '+%F %H:%M')"
    fi
  fi
  return 0
}

# quota [tên | --all]: xem quota thật. Account không phải active được đổi sang tạm thời rồi trả về như cũ.
cmd_quota() {
  need_jq; init_state
  command -v "$AGY_BIN" >/dev/null || die "không tìm thấy agy ($AGY_BIN)"
  local orig; orig="$(active_name)"
  local -a targets=()
  if [ "${1:-}" = "--all" ]; then
    mapfile -t targets < <(slots)
  elif [ $# -ge 1 ]; then
    valid_name "$1"
    [ -f "$ACCTS/$1.token" ] || die "không có slot '$1' (xem: agy-acct list)"
    targets=("$1")
  else
    [ -n "$orig" ] || die "chưa có account active (xem: agy-acct list)"
    targets=("$orig")
  fi
  [ "${#targets[@]}" -gt 0 ] || die "chưa có account nào" 2
  # dù bị ngắt giữa chừng cũng trả token về account ban đầu
  restore_orig() { if [ -n "$orig" ] && [ "$(active_name)" != "$orig" ]; then cmd_use "$orig" >/dev/null 2>&1 || true; fi; }
  trap restore_orig INT TERM
  local n fail=0
  for n in "${targets[@]}"; do
    if [ "$n" = "$(active_name)" ]; then
      echo "$n$([ "$n" = "$orig" ] && echo ' (active)'):"
    else
      cmd_use "$n" >/dev/null
      echo "$n:"
    fi
    quota_show "$n" || fail=1
  done
  restore_orig
  trap - INT TERM
  return "$fail"
}

# Dòng tóm tắt snapshot quota gần nhất của một account (rỗng nếu chưa đo lần nào).
quota_summary() {
  jq -r --arg n "$1" --argjson t "$(now)" '
    def f(p; r): if r <= $t then "đã reset" else "\(p)% (reset \(r | strflocaltime("%m-%d %H:%M")))" end;
    .quota[$n] // empty | "quota Gemini: 5h \(f(.g5; .g5r)) · tuần \(f(.gw; .gwr)) · đo lúc \(.at | strflocaltime("%m-%d %H:%M"))"' "$STATE"
}

cmd_active() { need_jq; init_state; active_name; }

usage() {
  cat <<'EOF'
agy-acct — xoay vòng nhiều account agy

  save <name>               lưu token hiện tại thành slot <name> (đặt làm active)
  use <name>                chuyển token sang slot <name> (sync token đang dùng về slot cũ)
  list                      liệt kê slot, account active (*) và cooldown
  active                    in tên account active
  cooldown <name> <thời gian>   đánh dấu hết quota; nhận "4h13m27s", "43m", 90 hoặc cả câu "… Resets in 4h13m27s."
  clear <name>              bỏ cooldown
  next                      in account sẵn sàng kế tiếp; exit 3 nếu cả pool đang cooldown
  quota [tên | --all]       xem quota thật (agy -p /quota, 0 token); --all đi qua từng account rồi trả token về như cũ;
                            về 0% thì tự đặt cooldown tới giờ reset. Kết quả lưu để 'list' hiển thị
  rotate [thời gian]        hết quota khi dùng agy tay: cooldown account đang active (đọc 'Resets in' từ log agy,
                            hoặc nhập tay) rồi chuyển sang account kế tiếp; sau đó mở lại bằng 'agy -c'

Sau mỗi lần login tay bằng 'agy', hãy chạy 'agy-acct save <name>' để slot không bị lệch.
EOF
}

main() {
  local c="${1:-}"; [ $# -gt 0 ] && shift
  case "$c" in
    save) cmd_save "$@" ;;
    use) cmd_use "$@" ;;
    list|ls) cmd_list "$@" ;;
    active) cmd_active "$@" ;;
    cooldown) cmd_cooldown "$@" ;;
    clear) cmd_clear "$@" ;;
    next) cmd_next "$@" ;;
    rotate) cmd_rotate "$@" ;;
    quota) cmd_quota "$@" ;;
    ""|-h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}
main "$@"
