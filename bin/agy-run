#!/usr/bin/env bash
# agy-run — chạy một task agy; khi account hết quota (429) thì kill, đổi sang
# account khác bằng agy-acct và resume đúng conversation đó.
#
# Dùng:
#   agy-run --prompt FILE --add-dir DIR --log FILE.jsonl [--model M]
#
# Exit code:
#   0 thành công | 1 agy lỗi khác | 2 sai tham số
#   4 lỗi đăng nhập (cần user login lại) | 5 cả pool hết quota | 6 đổi account quá nhiều lần
#
# Biến môi trường (dùng cho test):
#   AGY_BIN             binary agy (mặc định agy)
#   AGY_ACCT            lệnh agy-acct (mặc định: file cạnh script này)
#   AGY_RUN_POLL        giây giữa hai lần soi log (mặc định 1)
#   AGY_RUN_MAX_SWITCH  số lần đổi account tối đa (mặc định 6)
set -uo pipefail

AGY_BIN="${AGY_BIN:-agy}"
AGY_ACCT="${AGY_ACCT:-$(dirname "$(readlink -f "$0")")/agy-acct}"
POLL="${AGY_RUN_POLL:-1}"
MAX_SWITCH="${AGY_RUN_MAX_SWITCH:-6}"
MODEL="gemini-3.8-flash-high"

QUOTA_RE='Individual quota reached'
AUTH_RE="authentication required|authentication failed or timed out|not logged into Antigravity"

log() { echo "[agy-run] $*" >&2; }
die() { log "$1"; exit "${2:-1}"; }

PROMPT_FILE="" ADD_DIR="" LOG_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --prompt) PROMPT_FILE="${2:-}"; shift 2 ;;
    --add-dir) ADD_DIR="${2:-}"; shift 2 ;;
    --log) LOG_FILE="${2:-}"; shift 2 ;;
    --model) MODEL="${2:-}"; shift 2 ;;
    *) die "tham số lạ: $1 (dùng: --prompt FILE --add-dir DIR --log FILE [--model M])" 2 ;;
  esac
done
[ -f "$PROMPT_FILE" ] || die "--prompt phải là file tồn tại" 2
[ -d "$ADD_DIR" ] || die "--add-dir phải là thư mục tồn tại" 2
[ -n "$LOG_FILE" ] || die "thiếu --log" 2

CUR="$("$AGY_ACCT" active)" || die "agy-acct lỗi" 1
[ -n "$CUR" ] || die "chưa có account active; login rồi chạy: agy-acct save <name>" 4

ORIG_PROMPT="$(cat "$PROMPT_FILE")"
RESUME_NOTE="Continue the task from where you stopped. The previous account ran out of quota mid-run, so partial uncommitted edits may already exist in the working directory: check git status/diff first, finish and verify them, do not revert them."

PID=""
OFF=0

# chạy agy một lần; trả về: 0 xong SUCCESS | 10 quota | 11 auth | 1 lỗi khác
run_attempt() {
  OFF="$(stat -c %s "$LOG_FILE" 2>/dev/null || echo 0)"
  setsid "$AGY_BIN" "$@" --add-dir "$ADD_DIR" --model "$MODEL" \
    --dangerously-skip-permissions --output-format stream-json >>"$LOG_FILE" 2>&1 &
  PID=$!
  local chunk
  while kill -0 "$PID" 2>/dev/null; do
    chunk="$(tail -c +$((OFF + 1)) "$LOG_FILE")"
    if grep -qE "$QUOTA_RE" <<<"$chunk"; then stop_agy; return 10; fi
    if grep -qE "$AUTH_RE" <<<"$chunk"; then stop_agy; return 11; fi
    sleep "$POLL"
  done
  wait "$PID" 2>/dev/null
  chunk="$(tail -c +$((OFF + 1)) "$LOG_FILE")"
  if grep -qE "$QUOTA_RE" <<<"$chunk"; then return 10; fi
  if grep -qE "$AUTH_RE" <<<"$chunk"; then return 11; fi
  local st
  st="$(grep '^{' <<<"$chunk" | jq -r 'select(.event=="result") | .result.status' 2>/dev/null | tail -1)"
  [ "$st" = "SUCCESS" ] && return 0
  log "agy kết thúc với status '${st:-NO_RESULT}'"
  return 1
}

stop_agy() { # kill cả process group rồi thu dọn
  kill -TERM -- "-$PID" 2>/dev/null || kill -TERM "$PID" 2>/dev/null
  sleep 0.2
  kill -KILL -- "-$PID" 2>/dev/null
  wait "$PID" 2>/dev/null
  return 0
}

conv_id_from_log() { # conversation_id của event init đầu tiên trong đoạn log mới
  tail -c +$((OFF + 1)) "$LOG_FILE" | grep '^{"event":"init"' | head -1 |
    jq -r '.conversation_id // empty' 2>/dev/null
}

CONV=""
SWITCHES=0
ARGS=(-p "$ORIG_PROMPT")

while :; do
  log "chạy trên account '$CUR'${CONV:+ (resume $CONV)}"
  run_attempt "${ARGS[@]}"
  rc=$?
  id="$(conv_id_from_log)"
  [ -n "$id" ] && CONV="$id"

  case "$rc" in
    0) log "xong (account '$CUR')"; exit 0 ;;
    11) die "lỗi đăng nhập trên account '$CUR': hãy login lại bằng '! agy' rồi 'agy-acct save $CUR'" 4 ;;
    10) ;;
    *) exit 1 ;;
  esac

  reset="$(tail -c +$((OFF + 1)) "$LOG_FILE" | grep -m1 "$QUOTA_RE" | grep -oE 'Resets in [0-9dhms]+' | head -1)"
  log "account '$CUR' hết quota (${reset:-không rõ thời gian reset})"
  "$AGY_ACCT" cooldown "$CUR" "${reset:-5h}" >&2 || true

  SWITCHES=$((SWITCHES + 1))
  [ "$SWITCHES" -le "$MAX_SWITCH" ] || die "đã đổi account $MAX_SWITCH lần, dừng" 6
  if ! NEXT="$("$AGY_ACCT" next)"; then
    die "cả pool hết quota (conversation ${CONV:-chưa có}); chờ reset hoặc login account khác" 5
  fi
  "$AGY_ACCT" use "$NEXT" >&2 || die "không đổi được sang '$NEXT'" 1
  CUR="$NEXT"

  if [ -n "$CONV" ]; then
    ARGS=(--conversation "$CONV" -p "$RESUME_NOTE")
  else
    ARGS=(-p "$ORIG_PROMPT

NOTE: $RESUME_NOTE")
  fi
done
