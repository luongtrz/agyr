#!/usr/bin/env bash
# agyr — save / switch / rotate multiple accounts for agy (Antigravity CLI).
#
# It only copies token files around; it never prints token contents.
# Environment variables:
#   AGY_HOME  agy data directory (default ~/.gemini/antigravity-cli)
#   AGY_BIN   agy binary used to measure quota (default agy)
#   AGY_TZ    timezone for displayed times and for times read from agy logs
#             (default UTC-7, which is UTC+7 in POSIX notation)
#   AGY_NOW   fake epoch for "now" (tests only; default date +%s)
#   AGYR_COLOR  auto (default) | always | never — colours in the list table
set -euo pipefail
umask 077

# All displayed times (and times read from agy logs) are UTC+7. POSIX quirk: 'UTC-7' means UTC+7.
export TZ="${AGY_TZ:-UTC-7}"
export LC_TIME=C # so %p is always AM/PM, regardless of the machine's language

AGY_HOME="${AGY_HOME:-$HOME/.gemini/antigravity-cli}"
AGY_BIN="${AGY_BIN:-agy}"
# Since agy 1.2.14 the login lives in the OS keyring (GNOME keyring / libsecret, reached over D-Bus) and the token file
# is ignored whenever the keyring is reachable: swapping the token file then changes nothing (observed 2026-10-02: the
# banner kept showing the old account, and every account measured the same quota). Without a reachable session bus agy
# falls back to the token file in its HOME, so every agy that agyr starts gets this unreachable bus address.
NOKEYRING_BUS="unix:path=/nonexistent"
TOKEN="$AGY_HOME/antigravity-oauth-token"
ACCTS="$AGY_HOME/accounts"
STATE="$ACCTS/state.json"
DEFAULT_COOLDOWN=18000 # 5h, used when "Resets in" cannot be parsed

die() { echo "agyr: $*" >&2; exit "${2:-1}"; }
now() { echo "${AGY_NOW:-$(date +%s)}"; }

need_jq() { command -v jq >/dev/null || die "jq is required"; }

valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "account name may only contain letters, digits, '-' and '_': '$1'"; }

init_state() {
  mkdir -p "$ACCTS"
  chmod 700 "$ACCTS"
  [ -f "$STATE" ] || echo '{"active":"","cooldown":{}}' >"$STATE"
}

# atomic state write: $1 = jq expression, remaining args are passed to jq
state_update() {
  local expr="$1"; shift
  local tmp
  tmp="$(mktemp "$ACCTS/.state.XXXXXX")"
  if jq "$@" "$expr" "$STATE" >"$tmp"; then mv "$tmp" "$STATE"; else rm -f "$tmp"; die "failed to write state"; fi
}

# Internal identity of a token file, for comparison only — NEVER printed: the refresh_token if it is JSON, else the whole content.
ident_of() {
  local r
  r="$(jq -r '.token.refresh_token // empty' "$1" 2>/dev/null)" || r=""
  if [ -n "$r" ]; then printf 'rt:%s' "$r"; else printf 'raw:%s' "$(cat "$1")"; fi
}

# The slot the real token file belongs to (by identity); empty if it matches no slot (e.g. just logged in to an unsaved account).
real_owner() {
  [ -f "$TOKEN" ] || return 0
  local id n
  id="$(ident_of "$TOKEN")"
  while read -r n; do
    if [ "$(ident_of "$ACCTS/$n.token")" = "$id" ]; then echo "$n"; return 0; fi
  done < <(slots)
  return 0
}

# The account actually in use = the slot matching the real token file. Only when no slot matches do we fall back to the name
# stored in state (state can be stale when you log in with agy by hand without saving).
active_name() {
  local o
  o="$(real_owner)"
  if [ -n "$o" ]; then echo "$o"; else jq -r '.active // ""' "$STATE"; fi
}

# "4h13m27s" / "43m29s" / "1d2h" / "90" (seconds) -> seconds. Also accepts a sentence containing "Resets in X".
parse_duration() {
  local s="$1"
  if [[ "$s" =~ Resets\ in\ ([0-9dhms]+) ]]; then s="${BASH_REMATCH[1]}"; fi
  if [[ "$s" =~ ^[0-9]+$ ]]; then echo "$s"; return 0; fi
  [[ "$s" =~ ^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$ && -n "$s" ]] || return 1
  local total=0 d=${BASH_REMATCH[1]:-} h=${BASH_REMATCH[2]:-} m=${BASH_REMATCH[3]:-} sec=${BASH_REMATCH[4]:-}
  [ -n "$d" ] && total=$((total + ${d%d} * 86400))
  [ -n "$h" ] && total=$((total + ${h%h} * 3600))
  [ -n "$m" ] && total=$((total + ${m%m} * 60))
  [ -n "$sec" ] && total=$((total + ${sec%s}))
  echo "$total"
}

# epoch -> "dd/mm/yyyy hh:mm AM|PM" (in AGY_TZ)
fmt_time() { date -d "@$1" '+%d/%m/%Y %I:%M %p'; }

fmt_dur() { # seconds -> "4h13m"
  local s=$1
  if [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

slots() { # sorted slot names
  local f
  for f in "$ACCTS"/*.token; do
    [ -e "$f" ] || continue
    basename "$f" .token
  done | sort
}

cooldown_until() { jq -r --arg n "$1" '.cooldown[$n] // 0' "$STATE"; }

cmd_save() {
  [ $# -eq 1 ] || die "usage: agyr save <name>"
  valid_name "$1"; need_jq
  [ -f "$TOKEN" ] || die "no token yet ($TOKEN). Log in with 'agy' first"
  init_state
  cp "$TOKEN" "$ACCTS/$1.token"; chmod 600 "$ACCTS/$1.token"
  state_update '.active=$n | del(.cooldown[$n])' --arg n "$1"
  echo "saved account '$1' (now active)"
}

cmd_use() {
  [ $# -eq 1 ] || die "usage: agyr use <name>"
  valid_name "$1"; need_jq; init_state
  [ -f "$ACCTS/$1.token" ] || die "no slot '$1' (see: agyr list)"
  local cur; cur="$(real_owner)"
  if [ -f "$TOKEN" ]; then
    cp "$TOKEN" "$ACCTS/.last-token.bak"; chmod 600 "$ACCTS/.last-token.bak"
    # keep the access token agy refreshed, but only write it back to the slot it belongs to; if it matches no slot,
    # no slot is overwritten (the unsaved token is still in .last-token.bak)
    if [ -n "$cur" ] && [ "$cur" != "$1" ]; then
      cp "$TOKEN" "$ACCTS/$cur.token"; chmod 600 "$ACCTS/$cur.token"
    fi
  fi
  cp "$ACCTS/$1.token" "$TOKEN"; chmod 600 "$TOKEN"
  state_update '.active=$n' --arg n "$1"
  echo "switched to account '$1'"
}

cmd_cooldown() {
  [ $# -ge 2 ] || die "usage: agyr cooldown <name> <duration|'... Resets in 4h13m27s'>"
  local name="$1"; shift
  valid_name "$name"; need_jq; init_state
  [ -f "$ACCTS/$name.token" ] || die "no slot '$name'"
  local secs
  if ! secs="$(parse_duration "$*")"; then
    echo "agyr: cannot parse duration '$*', using default 5h" >&2
    secs=$DEFAULT_COOLDOWN
  fi
  local until=$(($(now) + secs))
  state_update '.cooldown[$n]=$u' --arg n "$name" --argjson u "$until"
  echo "account '$name' cooldown $(fmt_dur "$secs") (reset $(fmt_time "$until"))"
}

cmd_clear() {
  [ $# -eq 1 ] || die "usage: agyr clear <name>"
  valid_name "$1"; need_jq; init_state
  state_update 'del(.cooldown[$n])' --arg n "$1"
  echo "cleared cooldown of '$1'"
}

# Print the next ready account (round-robin, starting after the active one).
# If none is ready: exit 3 and report the earliest reset time.
cmd_next() {
  need_jq; init_state
  local cur t; cur="$(active_name)"; t="$(now)"
  local -a names=()
  mapfile -t names < <(slots)
  [ "${#names[@]}" -gt 0 ] || die "no accounts yet" 2
  local start=0 i
  for i in "${!names[@]}"; do [ "${names[$i]}" = "$cur" ] && start=$((i + 1)); done
  local k idx n until earliest=0 earliest_n=""
  for ((k = 0; k < ${#names[@]}; k++)); do
    idx=$(((start + k) % ${#names[@]}))
    n="${names[$idx]}"
    until="$(cooldown_until "$n")"
    if [ "$until" -le "$t" ]; then echo "$n"; return 0; fi
    if [ "$earliest" -eq 0 ] || [ "$until" -lt "$earliest" ]; then earliest=$until; earliest_n=$n; fi
  done
  echo "agyr: all ${#names[@]} accounts are on cooldown; earliest: '$earliest_n' resets at $(fmt_time "$earliest") ($(fmt_dur $((earliest - t))) left)" >&2
  return 3
}

# Find the most recent quota hit in agy's logs; print the seconds left until reset (counted from "now").
# Log line format: E1001 12:49:02.672827 ... Individual quota reached ... Resets in 3h13m51s.
# Lines older than 1 hour are ignored (most likely from another account / an earlier hit).
detect_reset_secs() {
  local logdir="$AGY_HOME/log" f line best_ts=0 best_reset=0 ts reset d t y t0
  [ -d "$logdir" ] || return 1
  t0="$(now)"
  y="$(date -d "@$t0" +%Y)"
  while read -r f; do
    line="$(grep -E 'Individual quota reached.*Resets in [0-9dhms]+' "$f" | tail -n 1)" || true
    [ -n "$line" ] || continue
    if [[ "$line" =~ ^[A-Z]([0-9]{2})([0-9]{2})\ ([0-9:]{8}) ]]; then
      d="$y-${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"; t="${BASH_REMATCH[3]}"
      ts="$(date -d "$d $t" +%s 2>/dev/null)" || continue
      [ "$ts" -gt $((t0 + 86400)) ] && ts="$(date -d "$((y - 1))-${BASH_REMATCH[1]}-${BASH_REMATCH[2]} $t" +%s)"
    else
      continue
    fi
    reset="$(parse_duration "$(grep -oE 'Resets in [0-9dhms]+' <<<"$line" | tail -n 1)")" || continue
    if [ "$ts" -gt "$best_ts" ]; then best_ts=$ts; best_reset=$reset; fi
  done < <(find "$logdir" -maxdepth 1 -name 'cli-*.log' -mmin -61 2>/dev/null)
  [ "$best_ts" -gt 0 ] || return 1
  [ $((t0 - best_ts)) -le 3600 ] || return 1
  local remain=$((best_ts + best_reset - t0))
  [ "$remain" -gt 0 ] || return 1
  echo "$remain"
}

# Out of quota while using agy by hand: put the active account on cooldown, then switch to the next account.
cmd_rotate() {
  need_jq; init_state
  local cur secs src
  cur="$(active_name)"
  [ -n "$cur" ] || die "no active account (see: agyr list)"
  if [ $# -ge 1 ]; then
    secs="$(parse_duration "$*")" || die "cannot parse duration '$*' (example: 4h13m)"
    src="as you entered"
  elif secs="$(detect_reset_secs)"; then
    src="read from the agy log"
  else
    secs=$DEFAULT_COOLDOWN
    src="no recent quota error in the log, using default 5h"
  fi
  local until=$(($(now) + secs))
  state_update '.cooldown[$n]=$u' --arg n "$cur" --argjson u "$until"
  echo "account '$cur' cooldown $(fmt_dur "$secs") ($src; reset $(fmt_time "$until"))"
  local nxt
  if ! nxt="$(cmd_next)"; then return 3; fi
  cmd_use "$nxt"
  echo "reopen agy (it must be a new process) with: agyr -c"
}

# Run `agy -p /quota` (no model call, 0 tokens) with HOME = $1 (a temp dir holding a copy of the token);
# print lines "<group>\t<metric>\t<percent>\t<reset time UTC>". Returns 1 on failure.
# AGY_HOME is also pointed there so the fake agy in tests reads the right token; real agy ignores it.
quota_fetch() {
  local home="$1" tmp out
  tmp="$(mktemp -d)"
  # setsid + empty stdin: agy runs without a controlling terminal. Otherwise several agy processes running in parallel
  # all change/restore your terminal mode (raw mode, terminal capability queries) and leave the terminal garbled
  # (staircase newlines, no echo).
  local -a detach=()
  if command -v setsid >/dev/null; then detach=(setsid -w); fi
  out="$(HOME="$home" AGY_HOME="$home/.gemini/antigravity-cli" DBUS_SESSION_BUS_ADDRESS="$NOKEYRING_BUS" \
    "${detach[@]}" "$AGY_BIN" -p /quota --add-dir "$tmp" \
    --model gemini-3.8-flash-high --output-format stream-json </dev/null 2>/dev/null |
    grep '^{' | jq -r 'select(.event=="result") | select(.result.status=="SUCCESS") | .result.response' 2>/dev/null)" || true
  rm -rf "$tmp"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# Measure one slot's quota in a temp HOME: does NOT touch the real token file, so it cannot break a running agy/agy-run
# and can run in parallel. $1 = slot name, $2 = file for the raw result, $3 = name of the active account.
measure_one() {
  local name="$1" out="$2" act="$3" home d src rc=0
  home="$(mktemp -d)"
  trap 'rm -rf "$home"' EXIT INT TERM
  d="$home/.gemini/antigravity-cli"
  mkdir -p "$d"
  if [ "$name" = "$act" ] && [ -f "$TOKEN" ]; then src="$TOKEN"; else src="$ACCTS/$name.token"; fi
  cp "$src" "$d/antigravity-oauth-token"; chmod 600 "$d/antigravity-oauth-token"
  # keep the same installation_id so Google sees the same agy installation
  if [ -f "$AGY_HOME/installation_id" ]; then cp "$AGY_HOME/installation_id" "$d/installation_id"; fi
  quota_fetch "$home" >"$out" 2>/dev/null || rc=$?
  # agy may have refreshed the token itself: write it back to the slot (for the active account the real token file is the source of truth)
  if [ "$name" != "$act" ] && [ -s "$d/antigravity-oauth-token" ] && ! cmp -s "$d/antigravity-oauth-token" "$ACCTS/$name.token"; then
    cp "$d/antigravity-oauth-token" "$ACCTS/$name.token"; chmod 600 "$ACCTS/$name.token"
  fi
  return "$rc"
}

# Parse the raw /quota output ($2) and store a Gemini snapshot in state. What was just measured is the truth, so:
# at 0% set a cooldown until the reset time; with quota left, clear any cooldown (e.g. the default 5h one set before the reset time was known).
# Fails if the Gemini numbers are missing.
quota_ingest() {
  local name="$1" raw="$2" grp metric pct reset epoch g5="" g5r=0 gw="" gwr=0
  while IFS=$'\t' read -r grp metric pct reset; do
    [ -n "$reset" ] || continue
    epoch="$(date -d "$reset" +%s 2>/dev/null)" || continue
    case "$grp|$metric" in
      "Gemini Models|Five Hour"*) g5="${pct%\%}"; g5r="$epoch" ;;
      "Gemini Models|Weekly"*) gw="${pct%\%}"; gwr="$epoch" ;;
    esac
  done <<<"$raw"
  [[ "$g5" =~ ^[0-9]+$ && "$gw" =~ ^[0-9]+$ ]] || return 1
  state_update '.quota[$n]={at:$t,g5:$a,g5r:$ar,gw:$b,gwr:$br}' --arg n "$name" --argjson t "$(now)" \
    --argjson a "$g5" --argjson ar "$g5r" --argjson b "$gw" --argjson br "$gwr"
  local until=0
  if [ "$g5" -eq 0 ]; then until=$g5r; fi
  if [ "$gw" -eq 0 ] && [ "$gwr" -gt "$until" ]; then until=$gwr; fi
  if [ "$until" -gt "$(now)" ]; then
    state_update '.cooldown[$n]=$u' --arg n "$name" --argjson u "$until"
  else
    state_update 'del(.cooldown[$n])' --arg n "$name"
  fi
  return 0
}

# Measure all slots ($@) in parallel and store snapshots; print the names of accounts that failed (space-separated).
measure_all() {
  local -a names=("$@") pids=() failed=()
  local d act i n
  d="$(mktemp -d)"
  act="$(real_owner)"
  for n in "${names[@]}"; do
    measure_one "$n" "$d/$n.out" "$act" &
    pids+=($!)
  done
  for i in "${!names[@]}"; do
    n="${names[$i]}"
    if wait "${pids[$i]}" && quota_ingest "$n" "$(cat "$d/$n.out")"; then :; else failed+=("$n"); fi
  done
  rm -rf "$d"
  echo "${failed[*]:-}"
}

# Print the table from state. $1 = names of accounts that failed to measure, $2 = 1 if measured just now.
print_table() {
  local failed=" $1 " live="$2" t cur n snap g5 g5r gw gwr at until st sc oldest=0 mark
  t="$(now)"; cur="$(real_owner)"
  # Colours: green = fine, yellow = needs attention, red = nearly out / unusable. Only used on a terminal (or with
  # AGYR_COLOR=always); NO_COLOR or AGYR_COLOR=never turns them off. Colour codes sit outside the padded fields so the table stays aligned.
  local G="" Y="" R="" Z="" usecolor=0
  case "${AGYR_COLOR:-auto}" in
    always) usecolor=1 ;;
    never) usecolor=0 ;;
    *) if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then usecolor=1; fi ;;
  esac
  if [ "$usecolor" = 1 ]; then G=$'\033[32m'; Y=$'\033[33m'; R=$'\033[31m'; Z=$'\033[0m'; fi
  pct() { # $1 = % left: <=10 red, <=40 yellow, otherwise green
    local c="$G"
    if [ "$1" -le 10 ]; then c="$R"; elif [ "$1" -le 40 ]; then c="$Y"; fi
    printf '%s%3s%%%s' "$c" "$1" "$Z"
  }
  cell() { # $1 = % left, $2 = reset time (epoch)
    if [ -z "$1" ] || [ "$2" -le "$t" ]; then printf '%4s  %-19s' '-' ''
    else printf '%s  %-19s' "$(pct "$1")" "$(fmt_time "$2")"; fi
  }
  printf '  %-14s %-25s   %-25s   %s\n' "ACCOUNT" "GEMINI 5H" "GEMINI WEEK" "STATUS"
  while read -r n; do
    g5=""; g5r=0; gw=""; gwr=0; at=0
    snap="$(jq -r --arg n "$n" '.quota[$n] // empty | [.g5,.g5r,.gw,.gwr,.at] | @tsv' "$STATE")"
    if [ -n "$snap" ]; then IFS=$'\t' read -r g5 g5r gw gwr at <<<"$snap"; fi
    if [[ "$failed" == *" $n "* ]]; then g5=""; fi
    if [ -n "$g5" ] && { [ "$oldest" -eq 0 ] || [ "$at" -lt "$oldest" ]; }; then oldest=$at; fi
    until="$(cooldown_until "$n")"
    if [[ "$failed" == *" $n "* ]]; then st="measure failed (token expired or agy error)"; sc="$R"
    elif [ "$until" -gt "$t" ]; then st="cooldown, $(fmt_dur $((until - t))) left"; sc="$R"
    elif [ -z "$g5" ]; then st="not measured"; sc="$Y"
    elif [ "$g5r" -le "$t" ] || [ "$gwr" -le "$t" ]; then st="stale, past reset time"; sc="$Y"
    elif [ "$g5" -le 10 ] || [ "$gw" -le 10 ]; then st="low"; sc="$R"
    else st="ready"; sc="$G"; fi
    mark=" "; if [ "$n" = "$cur" ]; then mark="*"; fi
    printf '%s %-14s %s   %s   %s%s%s\n' "$mark" "$n" "$(cell "$g5" "$g5r")" "$(cell "$gw" "$gwr")" "$sc" "$st" "$Z"
  done < <(slots)
  if [ -f "$TOKEN" ] && [ -z "$cur" ]; then
    echo "${Y}! The token file in use matches no slot (just logged in to another account?). Run 'agyr save <name>' to store it; 'agyr use' will not overwrite any slot.${Z}"
  fi
  if [ "$live" = 1 ]; then
    echo "Measured at $(fmt_time "$t")   (* = selected account)"
  elif [ "$oldest" -gt 0 ]; then
    echo "Oldest data measured at $(fmt_time "$oldest"). Run 'agyr list' (without -c) to refresh.   (* = selected account)"
  else
    echo "No quota data yet; run 'agyr list' (without -c) to measure.   (* = selected account)"
  fi
}

# list [-c|--cached]: measure every account's real quota (agy -p /quota, 0 tokens, in parallel) and print a table; * = selected account.
# -c only prints the saved data and does not call agy.
cmd_list() {
  need_jq; init_state
  local cached=0
  case "${1:-}" in
    -c|--cached) cached=1 ;;
    "") ;;
    *) die "usage: agyr list [-c|--cached]" 2 ;;
  esac
  local -a names=()
  mapfile -t names < <(slots)
  if [ "${#names[@]}" -eq 0 ]; then
    echo "(no accounts yet; log in with 'agy', then run 'agyr save <name>')"
    return 0
  fi
  local failed="" live=0
  if [ "$cached" -eq 0 ]; then
    if command -v "$AGY_BIN" >/dev/null; then
      if [ -t 2 ]; then printf 'Measuring quota of %d accounts…' "${#names[@]}" >&2; fi
      failed="$(measure_all "${names[@]}")"
      if [ -t 2 ]; then printf '\r\033[K' >&2; fi
      live=1
    else
      echo "agyr: agy not found ($AGY_BIN), showing saved data" >&2
    fi
  fi
  print_table "$failed" "$live"
  [ -z "$failed" ]
}

# run [agy args...]: start agy with the login saved in the token file instead of the OS keyring, so 'agyr use' works.
cmd_run() {
  command -v "$AGY_BIN" >/dev/null || die "agy not found ($AGY_BIN)"
  DBUS_SESSION_BUS_ADDRESS="$NOKEYRING_BUS" exec "$AGY_BIN" "$@"
}

cmd_active() { need_jq; init_state; active_name; }

usage() {
  cat <<'EOF'
agyr — rotate between multiple agy (Antigravity CLI) accounts

Usage: agyr <command> [args]        (agyr help <command> for the details of one command)
       agyr [agy arguments]         start agy with the selected account (same as 'agyr run'): 'agyr', 'agyr -c', 'agyr -p "..."'

Commands:
  list [-c]                Measure every account's quota and show a table (* = selected account)
  save <name>              Save the current login as slot <name>
  use <name>               Switch to slot <name>
  active                   Print the name of the account in use
  run [agy args]           Start agy with the selected account; plain 'agyr' / 'agyr -c' do the same
  rotate [time]            Interactive agy ran out of quota: cool this account down, switch to the next one
  next                     Print the next ready account
  cooldown <name> <time>   Mark an account as out of quota for a while
  clear <name>             Remove an account's cooldown
  help [command]           This overview, or the details of one command

Typical use:
  agyr save work           After logging in with 'agy': store that login as slot 'work' (once per account)
  agyr list                Which account still has quota?
  agyr use other           Switch account, then reopen agy with 'agyr'
  agyr rotate              agy ran out of quota: cool this account down and switch, then run 'agyr -c'

After every manual login with 'agy', run 'agyr save <name>' so the slot does not drift from the real account.
IMPORTANT: agy 1.2.14+ keeps its login in the OS keyring and ignores the token file, so a plain 'agy' always uses the
account stored there, whatever 'agyr use' selected. Start agy with plain 'agyr' (same as 'agyr run'; 'agyr -c' continues the last conversation) to use
the selected account. 'agyr list' and agy-run already take care of this themselves.

Exit codes:   0 ok | 1 error (or an account could not be measured) | 2 bad usage | 3 no account is ready
Environment:  AGYR_COLOR=auto|always|never (also NO_COLOR) | AGY_TZ (default UTC-7, i.e. UTC+7) | AGY_HOME | AGY_BIN
Files:        ~/.gemini/antigravity-cli/accounts/<name>.token (slots), accounts/state.json (active account, cooldowns,
              last measured quota), accounts/.last-token.bak (token that was replaced by the last 'use')
Also:         agy-run --help   (runs an agy task headless with automatic account rotation)
EOF
}

# agyr help [command] / agyr <command> --help
help_for() {
  case "${1:-}" in
    "") usage ;;
    save) cat <<'EOF'
Usage: agyr save <name>

Save the login currently in use (the token file ~/.gemini/antigravity-cli/antigravity-oauth-token) as slot <name> and
make <name> the active account. <name> may contain letters, digits, '-' and '_'.

Run it once per account after logging in with 'agy', and again after every manual re-login.
EOF
      ;;
    use) cat <<'EOF'
Usage: agyr use <name>

Switch to slot <name>. The token currently in use is first written back to the slot it belongs to (matched by
refresh_token, so an access token that agy refreshed is not lost). A token that matches no slot is never written into
any slot; it stays in accounts/.last-token.bak.

A running agy keeps its old token: reopen agy after switching ('agy -c' continues the last conversation).
EOF
      ;;
    list|ls) cat <<'EOF'
Usage: agyr list [-c|--cached]        (alias: ls)

Measure the real quota of every saved account with 'agy -p /quota' (no model call, 0 tokens) and print one table row per
account. The accounts are measured in parallel, each in a throwaway HOME holding a copy of its token, so the token in use
is never touched and running agy / agy-run processes are not disturbed.

  *            marks the account the real token file belongs to
  GEMINI 5H    % left of the 5-hour limit and when it resets
  GEMINI WEEK  % left of the weekly limit and when it resets
  STATUS       ready | low (10% or less left) | cooldown, <time> left | not measured | stale, past reset time |
               measure failed

An account at 0% automatically gets a cooldown until its reset time; an account with quota left has its cooldown cleared.
Colours: green above 40%, yellow 11-40%, red 10% or less. Only on a terminal (see NO_COLOR and AGYR_COLOR).

Options:
  -c, --cached   do not call agy; print the data saved by the last measurement

Exit code: 0 ok, 1 some account could not be measured.
EOF
      ;;
    active) cat <<'EOF'
Usage: agyr active

Print the name of the account in use: the slot the real token file belongs to (matched by refresh_token). If the token
file matches no slot, the name stored in state is printed instead. Prints nothing when there is no active account.
EOF
      ;;
    cooldown) cat <<'EOF'
Usage: agyr cooldown <name> <time>

Mark <name> as out of quota for <time>; 'next', 'rotate' and agy-run skip it until then.

<time> accepts 4h13m27s, 43m, 1d2h, plain seconds (90), or a whole sentence such as
"Individual quota reached. Resets in 4h13m27s." If it cannot be parsed, 5h is used.

'agyr list' sets and clears cooldowns by itself from the measured quota, so this is rarely needed by hand.
EOF
      ;;
    clear) cat <<'EOF'
Usage: agyr clear <name>

Remove the cooldown of <name>.
EOF
      ;;
    next) cat <<'EOF'
Usage: agyr next

Print the next ready account, round-robin starting after the active one (accounts on cooldown are skipped).
If every account is on cooldown: print nothing, report on stderr which one resets first, and exit 3.
EOF
      ;;
    rotate) cat <<'EOF'
Usage: agyr rotate [<time>]

For when an interactive agy runs out of quota: put the active account on cooldown and switch to the next ready one.
The reset time is read from the most recent "Individual quota reached ... Resets in X" line in agy's log (only lines from
the last hour); pass <time> (for example 4h13m) to give it yourself. If neither is available, 5h is used.

Then exit agy and reopen it with 'agy -c' (a running agy keeps its old token).
Exit code 3, and no switch, if every account is on cooldown.
EOF
      ;;
    run) cat <<'EOF'
Usage: agyr run [agy arguments...]        (shorthand: agyr [agy arguments...])

Start agy (interactive, or any agy arguments you pass, e.g. 'agyr -c' or 'agyr -p "..."') using the login saved
in the token file, i.e. the account selected by 'agyr use' / 'agyr rotate' / 'agyr list'.

Why it exists: since agy 1.2.14 the login is kept in the OS keyring (GNOME keyring over D-Bus) and the token file is
ignored while the keyring is reachable, so a plain 'agy' keeps using whatever account is stored there. 'agyr run' starts
agy with the session bus made unreachable, so agy falls back to the token file. Shorthand: 'agyr' alone, or 'agyr' followed by a flag, is the same as 'agyr run ...'.

Note: '--help' / '-h' as the first argument shows agyr's help instead of being passed to agy, and a first argument that
does not start with '-' is read as an agyr command (use 'agyr run <word>' to pass such an argument to agy, e.g. 'agyr run models').
EOF
      ;;
    help) cat <<'EOF'
Usage: agyr help [<command>]

Show the overview, or the details of one command. 'agyr <command> --help' works too.
EOF
      ;;
    *) echo "agyr: no such command '$1'" >&2; usage >&2; return 2 ;;
  esac
}

main() {
  # bare 'agyr' and 'agyr -<flag> ...' start agy (same as 'agyr run ...'); only -h/--help show agyr's help
  if [ $# -eq 0 ]; then cmd_run; fi
  case "$1" in
    -h|--help) usage; exit 0 ;;
    -*) cmd_run "$@" ;;
  esac
  local c="$1"; shift
  # agyr <command> --help
  case "${1:-}" in
    -h|--help) if [ -n "$c" ]; then help_for "$c"; exit $?; fi ;;
  esac
  case "$c" in
    save) cmd_save "$@" ;;
    use) cmd_use "$@" ;;
    list|ls) cmd_list "$@" ;;
    active) cmd_active "$@" ;;
    cooldown) cmd_cooldown "$@" ;;
    clear) cmd_clear "$@" ;;
    next) cmd_next "$@" ;;
    rotate) cmd_rotate "$@" ;;
    run) cmd_run "$@" ;;
    "") usage ;;
    help) help_for "$@" ;;
    *) usage >&2; exit 2 ;;
  esac
}
main "$@"
