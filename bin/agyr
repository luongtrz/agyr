#!/usr/bin/env bash
# agyr — lưu / đổi / xoay vòng nhiều account cho agy (Antigravity CLI).
#
# Chỉ copy file token qua lại; không bao giờ in nội dung token ra màn hình.
# Biến môi trường (dùng cho test):
#   AGY_HOME  thư mục dữ liệu của agy (mặc định ~/.gemini/antigravity-cli)
#   AGY_BIN   binary agy dùng cho lệnh quota (mặc định agy)
#   AGY_TZ    múi giờ để hiển thị và đọc giờ trong log agy (mặc định UTC-7, tức UTC+7 theo quy ước POSIX)
#   AGY_NOW   epoch giả lập cho "bây giờ" (mặc định date +%s)
set -euo pipefail
umask 077

# Mọi giờ hiển thị (và giờ trong log agy) tính theo UTC+7. Lưu ý quy ước POSIX: 'UTC-7' nghĩa là UTC+7.
export TZ="${AGY_TZ:-UTC-7}"
export LC_TIME=C # để %p luôn ra AM/PM, không theo ngôn ngữ của máy

AGY_HOME="${AGY_HOME:-$HOME/.gemini/antigravity-cli}"
AGY_BIN="${AGY_BIN:-agy}"
TOKEN="$AGY_HOME/antigravity-oauth-token"
ACCTS="$AGY_HOME/accounts"
STATE="$ACCTS/state.json"
DEFAULT_COOLDOWN=18000 # 5h, dùng khi không parse được "Resets in"

die() { echo "agyr: $*" >&2; exit "${2:-1}"; }
now() { echo "${AGY_NOW:-$(date +%s)}"; }

need_jq() { command -v jq >/dev/null || die "cần cài jq"; }

valid_name() { [[ "$1" =~ ^[A-Za-z0-9_-]+$ ]] || die "tên account chỉ gồm chữ, số, '-', '_': '$1'"; }

init_state() {
  mkdir -p "$ACCTS"
  chmod 700 "$ACCTS"
  [ -f "$STATE" ] || echo '{"active":"","cooldown":{}}' >"$STATE"
}

# ghi state nguyên tử: $1 = biểu thức jq, các tham số còn lại truyền cho jq
state_update() {
  local expr="$1"; shift
  local tmp
  tmp="$(mktemp "$ACCTS/.state.XXXXXX")"
  if jq "$@" "$expr" "$STATE" >"$tmp"; then mv "$tmp" "$STATE"; else rm -f "$tmp"; die "ghi state lỗi"; fi
}

# Định danh nội bộ của một file token để so sánh, KHÔNG BAO GIỜ in ra: refresh_token nếu là JSON, không thì cả nội dung.
ident_of() {
  local r
  r="$(jq -r '.token.refresh_token // empty' "$1" 2>/dev/null)" || r=""
  if [ -n "$r" ]; then printf 'rt:%s' "$r"; else printf 'raw:%s' "$(cat "$1")"; fi
}

# Slot mà file token thật đang thuộc về (so định danh); rỗng nếu không khớp slot nào (ví dụ vừa login account chưa save).
real_owner() {
  [ -f "$TOKEN" ] || return 0
  local id n
  id="$(ident_of "$TOKEN")"
  while read -r n; do
    if [ "$(ident_of "$ACCTS/$n.token")" = "$id" ]; then echo "$n"; return 0; fi
  done < <(slots)
  return 0
}

# Account đang dùng thật sự = slot khớp file token thật. Chỉ khi không khớp slot nào mới dùng tên đã ghi trong state
# (state có thể lệch khi bạn tự login bằng agy mà chưa save).
active_name() {
  local o
  o="$(real_owner)"
  if [ -n "$o" ]; then echo "$o"; else jq -r '.active // ""' "$STATE"; fi
}

# "4h13m27s" / "43m29s" / "1d2h" / "90" (giây) -> số giây. Chấp nhận cả câu chứa "Resets in X".
parse_duration() {
  local s="$1"
  if [[ "$s" =~ Resets\ in\ ([0-9dhms]+) ]]; then s="${BASH_REMATCH[1]}"; fi
  if [[ "$s" =~ ^[0-9]+$ ]]; then echo "$s"; return 0; fi
  [[ "$s" =~ ^([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?$ && -n "$s" ]] || return 1
  local total=0 d=${BASH_REMATCH[1]:-} h=${BASH_REMATCH[2]:-} m=${BASH_REMATCH[3]:-} sec=${BASH_REMATCH[4]:-}
  [ -n "$d" ] && total=$((total + ${d%d} * 86400))
  [ -n "$h" ] && total=$((total + ${h%h} * 3600))
  [ -n "$m" ] && total=$((total + ${m%m} * 60))
  [ -n "$sec" ] && total=$((total + ${sec%s}))
  echo "$total"
}

# epoch -> "dd/mm/yyyy hh:mm AM|PM" (theo AGY_TZ)
fmt_time() { date -d "@$1" '+%d/%m/%Y %I:%M %p'; }

fmt_dur() { # giây -> "4h13m"
  local s=$1
  if [ "$s" -ge 3600 ]; then printf '%dh%02dm' $((s / 3600)) $((s % 3600 / 60))
  elif [ "$s" -ge 60 ]; then printf '%dm%02ds' $((s / 60)) $((s % 60))
  else printf '%ds' "$s"; fi
}

slots() { # liệt kê tên các slot, sắp xếp
  local f
  for f in "$ACCTS"/*.token; do
    [ -e "$f" ] || continue
    basename "$f" .token
  done | sort
}

cooldown_until() { jq -r --arg n "$1" '.cooldown[$n] // 0' "$STATE"; }

cmd_save() {
  [ $# -eq 1 ] || die "dùng: agyr save <name>"
  valid_name "$1"; need_jq
  [ -f "$TOKEN" ] || die "chưa có token ($TOKEN). Hãy login bằng 'agy' trước"
  init_state
  cp "$TOKEN" "$ACCTS/$1.token"; chmod 600 "$ACCTS/$1.token"
  state_update '.active=$n | del(.cooldown[$n])' --arg n "$1"
  echo "đã lưu account '$1' (đang active)"
}

cmd_use() {
  [ $# -eq 1 ] || die "dùng: agyr use <name>"
  valid_name "$1"; need_jq; init_state
  [ -f "$ACCTS/$1.token" ] || die "không có slot '$1' (xem: agyr list)"
  local cur; cur="$(real_owner)"
  if [ -f "$TOKEN" ]; then
    cp "$TOKEN" "$ACCTS/.last-token.bak"; chmod 600 "$ACCTS/.last-token.bak"
    # giữ access token đã được agy refresh, nhưng chỉ ghi về đúng slot mà token này thuộc về; không khớp slot nào
    # thì không ghi đè slot nào cả (token chưa lưu vẫn còn trong .last-token.bak)
    if [ -n "$cur" ] && [ "$cur" != "$1" ]; then
      cp "$TOKEN" "$ACCTS/$cur.token"; chmod 600 "$ACCTS/$cur.token"
    fi
  fi
  cp "$ACCTS/$1.token" "$TOKEN"; chmod 600 "$TOKEN"
  state_update '.active=$n' --arg n "$1"
  echo "đã chuyển sang account '$1'"
}

cmd_cooldown() {
  [ $# -ge 2 ] || die "dùng: agyr cooldown <name> <duration|'... Resets in 4h13m27s'>"
  local name="$1"; shift
  valid_name "$name"; need_jq; init_state
  [ -f "$ACCTS/$name.token" ] || die "không có slot '$name'"
  local secs
  if ! secs="$(parse_duration "$*")"; then
    echo "agyr: không parse được thời gian '$*', dùng mặc định 5h" >&2
    secs=$DEFAULT_COOLDOWN
  fi
  local until=$(($(now) + secs))
  state_update '.cooldown[$n]=$u' --arg n "$name" --argjson u "$until"
  echo "account '$name' cooldown $(fmt_dur "$secs") (reset $(fmt_time "$until"))"
}

cmd_clear() {
  [ $# -eq 1 ] || die "dùng: agyr clear <name>"
  valid_name "$1"; need_jq; init_state
  state_update 'del(.cooldown[$n])' --arg n "$1"
  echo "đã xóa cooldown của '$1'"
}

# In tên account sẵn sàng kế tiếp (vòng tròn, bắt đầu sau account active).
# Hết sạch thì exit 3 và báo thời điểm reset sớm nhất.
cmd_next() {
  need_jq; init_state
  local cur t; cur="$(active_name)"; t="$(now)"
  local -a names=()
  mapfile -t names < <(slots)
  [ "${#names[@]}" -gt 0 ] || die "chưa có account nào" 2
  local start=0 i
  for i in "${!names[@]}"; do [ "${names[$i]}" = "$cur" ] && start=$((i + 1)); done
  local k idx n until earliest=0 earliest_n=""
  for ((k = 0; k < ${#names[@]}; k++)); do
    idx=$(((start + k) % ${#names[@]}))
    n="${names[$idx]}"
    until="$(cooldown_until "$n")"
    if [ "$until" -le "$t" ]; then echo "$n"; return 0; fi
    if [ "$earliest" -eq 0 ] || [ "$until" -lt "$earliest" ]; then earliest=$until; earliest_n=$n; fi
  done
  echo "agyr: tất cả ${#names[@]} account đều đang cooldown; sớm nhất: '$earliest_n' reset $(fmt_time "$earliest") (còn $(fmt_dur $((earliest - t))))" >&2
  return 3
}

# Tìm lần chạm quota gần nhất trong log của agy; in số giây còn lại tới lúc reset (tính từ "bây giờ").
# Dòng log dạng: E1001 12:49:02.672827 ... Individual quota reached ... Resets in 3h13m51s.
# Bỏ qua dòng cũ hơn 1 giờ (rất có thể là của account khác / lần trước).
detect_reset_secs() {
  local logdir="$AGY_HOME/log" f line best_ts=0 best_reset=0 ts reset d t y t0
  [ -d "$logdir" ] || return 1
  t0="$(now)"
  y="$(date -d "@$t0" +%Y)"
  while read -r f; do
    line="$(grep -E 'Individual quota reached.*Resets in [0-9dhms]+' "$f" | tail -n 1)" || true
    [ -n "$line" ] || continue
    if [[ "$line" =~ ^[A-Z]([0-9]{2})([0-9]{2})\ ([0-9:]{8}) ]]; then
      d="$y-${BASH_REMATCH[1]}-${BASH_REMATCH[2]}"; t="${BASH_REMATCH[3]}"
      ts="$(date -d "$d $t" +%s 2>/dev/null)" || continue
      [ "$ts" -gt $((t0 + 86400)) ] && ts="$(date -d "$((y - 1))-${BASH_REMATCH[1]}-${BASH_REMATCH[2]} $t" +%s)"
    else
      continue
    fi
    reset="$(parse_duration "$(grep -oE 'Resets in [0-9dhms]+' <<<"$line" | tail -n 1)")" || continue
    if [ "$ts" -gt "$best_ts" ]; then best_ts=$ts; best_reset=$reset; fi
  done < <(find "$logdir" -maxdepth 1 -name 'cli-*.log' -mmin -61 2>/dev/null)
  [ "$best_ts" -gt 0 ] || return 1
  [ $((t0 - best_ts)) -le 3600 ] || return 1
  local remain=$((best_ts + best_reset - t0))
  [ "$remain" -gt 0 ] || return 1
  echo "$remain"
}

# Hết quota khi dùng agy tay: đánh dấu account đang active là cooldown rồi chuyển sang account kế tiếp.
cmd_rotate() {
  need_jq; init_state
  local cur secs src
  cur="$(active_name)"
  [ -n "$cur" ] || die "chưa có account active (xem: agyr list)"
  if [ $# -ge 1 ]; then
    secs="$(parse_duration "$*")" || die "không hiểu thời gian '$*' (ví dụ: 4h13m)"
    src="theo bạn nhập"
  elif secs="$(detect_reset_secs)"; then
    src="đọc từ log agy"
  else
    secs=$DEFAULT_COOLDOWN
    src="không thấy lỗi quota mới trong log, dùng mặc định 5h"
  fi
  local until=$(($(now) + secs))
  state_update '.cooldown[$n]=$u' --arg n "$cur" --argjson u "$until"
  echo "account '$cur' cooldown $(fmt_dur "$secs") ($src; reset $(fmt_time "$until"))"
  local nxt
  if ! nxt="$(cmd_next)"; then return 3; fi
  cmd_use "$nxt"
  echo "mở lại agy (đang là process mới) bằng: agy -c"
}

# Chạy `agy -p /quota` (không gọi model, 0 token) với HOME = $1 (thư mục tạm chứa bản sao token);
# in các dòng "<nhóm>\t<chỉ số>\t<phần trăm>\t<giờ reset UTC>". Lỗi thì return 1.
# AGY_HOME cũng được trỏ vào đó để agy giả trong test đọc đúng token; agy thật bỏ qua biến này.
quota_fetch() {
  local home="$1" tmp out
  tmp="$(mktemp -d)"
  # setsid + stdin rỗng: agy chạy không có terminal điều khiển. Nếu không, nhiều agy chạy song song cùng đổi/khôi phục
  # chế độ terminal của bạn (raw mode, truy vấn khả năng terminal) và để lại terminal bị vỡ (xuống dòng lệch, mất echo).
  local -a detach=()
  if command -v setsid >/dev/null; then detach=(setsid -w); fi
  out="$(HOME="$home" AGY_HOME="$home/.gemini/antigravity-cli" "${detach[@]}" "$AGY_BIN" -p /quota --add-dir "$tmp" \
    --model gemini-3.8-flash-high --output-format stream-json </dev/null 2>/dev/null |
    grep '^{' | jq -r 'select(.event=="result") | select(.result.status=="SUCCESS") | .result.response' 2>/dev/null)" || true
  rm -rf "$tmp"
  [ -n "$out" ] || return 1
  printf '%s\n' "$out"
}

# Đo quota của một slot trong HOME tạm: KHÔNG đụng file token thật, nên không làm hỏng agy/agy-run đang chạy
# và đo song song được. $1 = tên slot, $2 = file ghi kết quả thô, $3 = tên account đang active.
measure_one() {
  local name="$1" out="$2" act="$3" home d src rc=0
  home="$(mktemp -d)"
  trap 'rm -rf "$home"' EXIT INT TERM
  d="$home/.gemini/antigravity-cli"
  mkdir -p "$d"
  if [ "$name" = "$act" ] && [ -f "$TOKEN" ]; then src="$TOKEN"; else src="$ACCTS/$name.token"; fi
  cp "$src" "$d/antigravity-oauth-token"; chmod 600 "$d/antigravity-oauth-token"
  # giữ cùng installation_id để Google thấy đây vẫn là cùng một cài đặt agy
  if [ -f "$AGY_HOME/installation_id" ]; then cp "$AGY_HOME/installation_id" "$d/installation_id"; fi
  quota_fetch "$home" >"$out" 2>/dev/null || rc=$?
  # agy có thể đã tự làm mới token: ghi lại vào slot (riêng account active thì file token thật mới là nguồn đúng)
  if [ "$name" != "$act" ] && [ -s "$d/antigravity-oauth-token" ] && ! cmp -s "$d/antigravity-oauth-token" "$ACCTS/$name.token"; then
    cp "$d/antigravity-oauth-token" "$ACCTS/$name.token"; chmod 600 "$ACCTS/$name.token"
  fi
  return "$rc"
}

# Đọc kết quả thô của /quota ($2), lưu snapshot Gemini vào state. Số liệu vừa đo là sự thật nên:
# về 0% thì đặt cooldown tới giờ reset, còn quota thì xóa cooldown (ví dụ cooldown mặc định 5h đặt khi chưa biết giờ reset).
# Lỗi nếu thiếu số liệu Gemini.
quota_ingest() {
  local name="$1" raw="$2" grp metric pct reset epoch g5="" g5r=0 gw="" gwr=0
  while IFS=$'\t' read -r grp metric pct reset; do
    [ -n "$reset" ] || continue
    epoch="$(date -d "$reset" +%s 2>/dev/null)" || continue
    case "$grp|$metric" in
      "Gemini Models|Five Hour"*) g5="${pct%\%}"; g5r="$epoch" ;;
      "Gemini Models|Weekly"*) gw="${pct%\%}"; gwr="$epoch" ;;
    esac
  done <<<"$raw"
  [[ "$g5" =~ ^[0-9]+$ && "$gw" =~ ^[0-9]+$ ]] || return 1
  state_update '.quota[$n]={at:$t,g5:$a,g5r:$ar,gw:$b,gwr:$br}' --arg n "$name" --argjson t "$(now)" \
    --argjson a "$g5" --argjson ar "$g5r" --argjson b "$gw" --argjson br "$gwr"
  local until=0
  if [ "$g5" -eq 0 ]; then until=$g5r; fi
  if [ "$gw" -eq 0 ] && [ "$gwr" -gt "$until" ]; then until=$gwr; fi
  if [ "$until" -gt "$(now)" ]; then
    state_update '.cooldown[$n]=$u' --arg n "$name" --argjson u "$until"
  else
    state_update 'del(.cooldown[$n])' --arg n "$name"
  fi
  return 0
}

# Đo song song tất cả slot ($@), lưu snapshot; in tên các account đo lỗi (cách nhau bằng dấu cách).
measure_all() {
  local -a names=("$@") pids=() failed=()
  local d act i n
  d="$(mktemp -d)"
  act="$(real_owner)"
  for n in "${names[@]}"; do
    measure_one "$n" "$d/$n.out" "$act" &
    pids+=($!)
  done
  for i in "${!names[@]}"; do
    n="${names[$i]}"
    if wait "${pids[$i]}" && quota_ingest "$n" "$(cat "$d/$n.out")"; then :; else failed+=("$n"); fi
  done
  rm -rf "$d"
  echo "${failed[*]:-}"
}

# In bảng từ state. $1 = tên các account đo lỗi, $2 = 1 nếu vừa đo xong.
print_table() {
  local failed=" $1 " live="$2" t cur n snap g5 g5r gw gwr at until st oldest=0 mark
  t="$(now)"; cur="$(real_owner)"
  cell() { # $1 = % còn lại, $2 = giờ reset (epoch)
    if [ -z "$1" ] || [ "$2" -le "$t" ]; then printf '%4s  %-19s' '-' ''
    else printf '%3s%%  %-19s' "$1" "$(fmt_time "$2")"; fi
  }
  printf '  %-14s %-25s   %-25s   %s\n' "ACCOUNT" "GEMINI 5H" "GEMINI WEEK" "STATUS"
  while read -r n; do
    g5=""; g5r=0; gw=""; gwr=0; at=0
    snap="$(jq -r --arg n "$n" '.quota[$n] // empty | [.g5,.g5r,.gw,.gwr,.at] | @tsv' "$STATE")"
    if [ -n "$snap" ]; then IFS=$'\t' read -r g5 g5r gw gwr at <<<"$snap"; fi
    if [[ "$failed" == *" $n "* ]]; then g5=""; fi
    if [ -n "$g5" ] && { [ "$oldest" -eq 0 ] || [ "$at" -lt "$oldest" ]; }; then oldest=$at; fi
    until="$(cooldown_until "$n")"
    if [[ "$failed" == *" $n "* ]]; then st="không đo được (token hết hạn hoặc agy lỗi)"
    elif [ "$until" -gt "$t" ]; then st="cooldown, còn $(fmt_dur $((until - t)))"
    elif [ -z "$g5" ]; then st="chưa đo"
    elif [ "$g5r" -le "$t" ] || [ "$gwr" -le "$t" ]; then st="số liệu cũ, đã qua giờ reset"
    elif [ "$g5" -le 10 ] || [ "$gw" -le 10 ]; then st="sắp hết"
    else st="sẵn sàng"; fi
    mark=" "; if [ "$n" = "$cur" ]; then mark="*"; fi
    printf '%s %-14s %s   %s   %s\n' "$mark" "$n" "$(cell "$g5" "$g5r")" "$(cell "$gw" "$gwr")" "$st"
  done < <(slots)
  if [ -f "$TOKEN" ] && [ -z "$cur" ]; then
    echo "! File token đang dùng không khớp slot nào (vừa login account khác?). Chạy 'agyr save <tên>' để lưu nó; 'agyr use' sẽ không ghi đè slot nào."
  fi
  if [ "$live" = 1 ]; then
    echo "Đo lúc $(fmt_time "$t")   (* = account đang chọn)"
  elif [ "$oldest" -gt 0 ]; then
    echo "Số liệu cũ nhất đo lúc $(fmt_time "$oldest"). Chạy 'agyr list' (không kèm -c) để đo lại.   (* = account đang chọn)"
  else
    echo "Chưa có số liệu quota; chạy 'agyr list' (không kèm -c) để đo.   (* = account đang chọn)"
  fi
}

# list [-c|--cached]: đo quota thật của mọi account (agy -p /quota, 0 token, song song) rồi in bảng; * = account đang chọn.
# -c chỉ in số liệu đã lưu, không gọi agy.
cmd_list() {
  need_jq; init_state
  local cached=0
  case "${1:-}" in
    -c|--cached) cached=1 ;;
    "") ;;
    *) die "dùng: agyr list [-c|--cached]" 2 ;;
  esac
  local -a names=()
  mapfile -t names < <(slots)
  if [ "${#names[@]}" -eq 0 ]; then
    echo "(chưa có account nào; login bằng 'agy' rồi chạy 'agyr save <name>')"
    return 0
  fi
  local failed="" live=0
  if [ "$cached" -eq 0 ]; then
    if command -v "$AGY_BIN" >/dev/null; then
      if [ -t 2 ]; then printf 'Đang đo quota của %d account…' "${#names[@]}" >&2; fi
      failed="$(measure_all "${names[@]}")"
      if [ -t 2 ]; then printf '\r\033[K' >&2; fi
      live=1
    else
      echo "agyr: không tìm thấy agy ($AGY_BIN), hiển thị số liệu đã lưu" >&2
    fi
  fi
  print_table "$failed" "$live"
  [ -z "$failed" ]
}

cmd_active() { need_jq; init_state; active_name; }

usage() {
  cat <<'EOF'
agyr — xoay vòng nhiều account agy

  save <name>               lưu token hiện tại thành slot <name> (đặt làm active)
  use <name>                chuyển token sang slot <name> (sync token đang dùng về slot cũ)
  list [-c]                 đo quota thật của mọi account (agy -p /quota, 0 token, song song, không đụng token đang dùng)
                            và in bảng; * = account đang chọn. -c: chỉ in số liệu đã lưu. Về 0% thì tự đặt cooldown
  active                    in tên account active
  cooldown <name> <thời gian>   đánh dấu hết quota; nhận "4h13m27s", "43m", 90 hoặc cả câu "… Resets in 4h13m27s."
  clear <name>              bỏ cooldown
  next                      in account sẵn sàng kế tiếp; exit 3 nếu cả pool đang cooldown
  rotate [thời gian]        hết quota khi dùng agy tay: cooldown account đang active (đọc 'Resets in' từ log agy,
                            hoặc nhập tay) rồi chuyển sang account kế tiếp; sau đó mở lại bằng 'agy -c'

Sau mỗi lần login tay bằng 'agy', hãy chạy 'agyr save <name>' để slot không bị lệch.
EOF
}

main() {
  local c="${1:-}"; [ $# -gt 0 ] && shift
  case "$c" in
    save) cmd_save "$@" ;;
    use) cmd_use "$@" ;;
    list|ls) cmd_list "$@" ;;
    active) cmd_active "$@" ;;
    cooldown) cmd_cooldown "$@" ;;
    clear) cmd_clear "$@" ;;
    next) cmd_next "$@" ;;
    rotate) cmd_rotate "$@" ;;
    ""|-h|--help|help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}
main "$@"
